<?xml version="1.0" encoding="utf-8"?>
<!-- PoC M1 manifest. min/targetSdk come from app/build.gradle (28/28).
     extractNativeLibs="true" is CRITICAL: box64 and the payload ship as jniLibs
     .so files and must be extracted as real, executable files in nativeLibraryDir. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="SoS PS5 - PoC box64"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
